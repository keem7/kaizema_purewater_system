# Kaizema Pure Water — local env example.
# Copy to .env and fill in real values. NEVER commit .env itself.

PORT=3000

# Required for auth. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-hex-chars

# Supabase project (server-only, never exposed to the frontend bundle).
SUPABASE_URL=https://your-project.supabase.co

# Public anon key. Subject to RLS — only public-read tables (e.g. settings) are reachable.
SUPABASE_ANON_KEY=replace-with-anon-key

# Service-role key. BYPASSES RLS — only use from server-side code that has been
# reviewed for injection / authorization. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key